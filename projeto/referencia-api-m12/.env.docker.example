# Variáveis do ambiente de DESENVOLVIMENTO com Docker. Este arquivo NÃO vai para o Git.
DEBUG=0
SECRET_KEY=troque-esta-chave-no-seu-.env
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=0
POSTGRES_PASSWORD=troque-no-seu-env
DATABASE_URL=postgres://minishop:troque-no-seu-env@db:5432/minishop
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/1
EMAIL_OUTBOX_FILE=/data/outbox.jsonl
